diff --git a/scripts/verify-recovery.ps1 b/scripts/verify-recovery.ps1
new file mode 100644
index 0000000..fc51cd0
--- /dev/null
+++ b/scripts/verify-recovery.ps1
@@ -0,0 +1,44 @@
+param([Parameter(Mandatory=$true)][string]$EvidenceDirectory)
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path $PSScriptRoot -Parent
+New-Item -ItemType Directory -Path $EvidenceDirectory -Force | Out-Null
+$evidence = (Resolve-Path -LiteralPath $EvidenceDirectory).Path
+$container = 'week10-fix-' + [guid]::NewGuid().ToString('N').Substring(0,12)
+$password = [guid]::NewGuid().ToString('N')
+$oldPassword = $env:POSTGRES_PASSWORD
+$oldDatabase = $env:TEST_DATABASE_URL
+$env:POSTGRES_PASSWORD = $password
+try {
+    docker run -d --rm --name $container --mount type=tmpfs,destination=/var/lib/postgresql -p '127.0.0.1::5432' -e POSTGRES_PASSWORD postgres:18.6-alpine | Out-Null
+    if ($LASTEXITCODE -ne 0) { throw 'PostgreSQL did not start' }
+    $ready = $false
+    for ($i=0; $i -lt 30; $i++) {
+        $ErrorActionPreference = 'Continue'
+        docker exec $container pg_isready -h 127.0.0.1 -U postgres *> $null
+        if ($LASTEXITCODE -eq 0) { $ready=$true; break }
+        Start-Sleep -Seconds 1
+    }
+    $ErrorActionPreference = 'Stop'
+    if (!$ready) { throw 'Readiness timeout' }
+    $port = ((docker port $container 5432/tcp).Trim() -split ':')[-1]
+    $env:TEST_DATABASE_URL = "postgres://postgres:${password}@127.0.0.1:${port}/postgres?sslmode=disable"
+    Push-Location $repo
+    try {
+        $log = Join-Path $evidence 'workflow-corregido.jsonl'
+        go test -json -count=1 ./... 2>&1 | ForEach-Object { ([string]$_).Replace($password,'[REDACTED]') } | Set-Content -LiteralPath $log -Encoding UTF8
+        if ($LASTEXITCODE -ne 0) { throw 'Workflow suite failed' }
+        $raw = [System.IO.File]::ReadAllText($log)
+        if ($raw -match '"Action":"(fail|skip)".*"Test"' -or $raw -notmatch '"Action":"pass".*"Test"') { throw 'Missing, failed or omitted tests' }
+        go vet ./...
+        if ($LASTEXITCODE -ne 0) { throw 'go vet failed' }
+        git diff --check
+        if ($LASTEXITCODE -ne 0) { throw 'Whitespace check failed' }
+        Write-Output 'PASS: modified workflow full suite against real disposable PostgreSQL, plus go vet'
+    } finally { Pop-Location }
+} finally {
+    $ErrorActionPreference = 'SilentlyContinue'
+    docker rm -f $container *> $null
+    $env:POSTGRES_PASSWORD = $oldPassword
+    $env:TEST_DATABASE_URL = $oldDatabase
+    $ErrorActionPreference = 'Stop'
+}
