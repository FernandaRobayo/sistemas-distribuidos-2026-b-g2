diff --git a/internal/adapter/out/state/postgres/runner.go b/internal/adapter/out/state/postgres/runner.go
new file mode 100644
index 0000000..3d8af4d
--- /dev/null
+++ b/internal/adapter/out/state/postgres/runner.go
@@ -0,0 +1,38 @@
+package postgres
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// AcquireRunner enforces the single-runtime recovery policy without a schema change.
+// The database-scoped advisory lock lives on a dedicated connection until shutdown.
+// Multi-runner recovery still requires durable claims and fencing before scaling out.
+func AcquireRunner(ctx context.Context, pool *pgxpool.Pool) (func(), error) {
+	lockCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	pooled, err := pool.Acquire(lockCtx)
+	if err != nil {
+		return nil, errors.New("workflow runner connection cannot be acquired")
+	}
+	conn := pooled.Hijack()
+	var once sync.Once
+	release := func() {
+		once.Do(func() {
+			closeCtx, cancelClose := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancelClose()
+			_ = conn.Close(closeCtx)
+		})
+	}
+	var acquired bool
+	err = conn.QueryRow(lockCtx, `SELECT pg_try_advisory_lock(hashtextextended($1::text, 0))`, "multi-tour-workflow-onboard-tenant").Scan(&acquired)
+	if err != nil || !acquired {
+		release()
+		return nil, errors.New("workflow runner lock unavailable; another instance may be active")
+	}
+	return release, nil
+}
