@@ -0,0 +1,50 @@
+package postgres_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/code-corhuila/multi-tour-workflow-onboard-tenant/internal/adapter/out/state/postgres"
+	"github.com/code-corhuila/multi-tour-workflow-onboard-tenant/internal/adapter/out/state/postgres/pgtest"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+func TestI_runner_lock_rejects_a_second_pool_and_allows_restart_after_release(t *testing.T) {
+	pool := pgtest.OpenAsApp(t)
+	other, err := pgxpool.NewWithConfig(context.Background(), pool.Config().Copy())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(other.Close)
+	release, err := postgres.AcquireRunner(context.Background(), pool)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(release)
+	if second, err := postgres.AcquireRunner(context.Background(), other); err == nil {
+		second()
+		t.Fatal("a second runtime acquired the same database runner lock")
+	}
+	release()
+	release() // release is safe on repeated shutdown paths
+	next, err := postgres.AcquireRunner(context.Background(), other)
+	if err != nil {
+		t.Fatal(err)
+	}
+	next()
+}
+
+func TestI_cancelled_runner_acquisition_does_not_hold_the_lock(t *testing.T) {
+	pool := pgtest.OpenAsApp(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if release, err := postgres.AcquireRunner(ctx, pool); err == nil {
+		release()
+		t.Fatal("cancelled acquisition succeeded")
+	}
+	release, err := postgres.AcquireRunner(context.Background(), pool)
+	if err != nil {
+		t.Fatal(err)
+	}
+	release()
+}
