{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multitour.local/contracts/events/pago-confirmado.v1.schema.json",
  "title": "PagoConfirmado v1",
  "description": "Dinero efectivamente confirmado; no incluye transferencias pendientes o rechazadas.",
  "type": "object",
  "required": ["eventId", "type", "tenantId", "reservationId", "movementId", "amountMinor", "currency"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "type": { "const": "PagoConfirmado" },
    "tenantId": { "type": "string", "minLength": 1 },
    "reservationId": { "type": "string", "minLength": 1 },
    "movementId": { "type": "string", "minLength": 1 },
    "amountMinor": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "currency": { "const": "COP" }
  },
  "additionalProperties": true
}
