    <bpmn:textAnnotation id="TextAnnotation_1jd8srw">
      <bpmn:text>Continuación BPMN-02:
Transferencia → comprobante.
 Efectivo/Abono → registrar pago y Mis reservas.
 Un fallo de pago no elimina la reserva creada</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1i2ba97" associationDirection="None" sourceRef="Event_0ga9xg6" targetRef="TextAnnotation_1jd8srw" />
    <bpmn:textAnnotation id="TextAnnotation_0ve0yqs">
      <bpmn:text>Valida fecha, cupo, titular, acompañantes, documentos, condiciones, modalidad de pago y, si aplica, abono válido: 0 &lt; abono ≤ valor final.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_07gdild" associationDirection="None" sourceRef="Activity_0uo0bpn" targetRef="TextAnnotation_0ve0yqs" />
