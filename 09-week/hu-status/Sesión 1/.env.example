# Copiar a .env solo para desarrollo local. Nunca registrar .env ni poner
# valores reales en este archivo; producción debe inyectarlos desde un gestor
# de secretos o desde la configuración protegida del entorno.
FRONTEND_PORT=8086
POSTGRES_DB=multitour
POSTGRES_USER=multitour_app
POSTGRES_PASSWORD=<inject-from-secret-store>
APP_JWT_SECRET=<inject-a-random-secret-of-at-least-32-characters>
APP_PLATFORM_ADMIN_PASSWORD=<inject-platform-admin-password>
APP_DEMO_SEED_ENABLED=false
APP_FEATURE_HEALTH_DIAGNOSTICS=false
API_UPSTREAM=backend:8080
