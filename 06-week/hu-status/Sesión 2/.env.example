# DEV: contrato objetivo de MVP 2, pendiente de conectar al Compose.
# Copiar a .env.dev (ignorado). Completar secretos solo fuera de Git.
COMPOSE_PROJECT_NAME=multitour-mvp2-dev
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8087
POSTGRES_DB=multitour_dev
POSTGRES_USER=multitour_dev
# Secreto privado dev/postgres-password
POSTGRES_PASSWORD=
# Secreto privado dev/jwt-secret
APP_JWT_SECRET=
API_UPSTREAM=backend:8080
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=2000
APP_DEMO_SEED_ENABLED=true
