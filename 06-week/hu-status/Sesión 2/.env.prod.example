# PROD: contrato objetivo de MVP 2, pendiente de conectar al Compose.
# Copiar a .env.prod (ignorado). Completar secretos solo fuera de Git.
COMPOSE_PROJECT_NAME=multitour-mvp2-prod
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8089
POSTGRES_DB=multitour_prod
POSTGRES_USER=multitour_prod
# Secreto privado prod/postgres-password
POSTGRES_PASSWORD=
# Secreto privado prod/jwt-secret
APP_JWT_SECRET=
API_UPSTREAM=backend:8080
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=2000
APP_DEMO_SEED_ENABLED=false
